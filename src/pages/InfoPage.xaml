<Page
    x:Class="LiveCaptionsTranslator.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="InfoPage"
    FontSize="14"
    JournalEntry.KeepAlive="False"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border
            MaxWidth="640"
            Margin="16"
            Padding="24,20,24,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource PageCard}">
            <!--  The names on the left are one column, what belongs to them a second one (in both tables).  -->
            <StackPanel Grid.IsSharedSizeScope="True">
                <StackPanel.Resources>
                    <Style x:Key="Key" TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,0,16,8" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Style>
                    <Style x:Key="Value" TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                </StackPanel.Resources>

                <!--  What this is: the icon, the name and (small, under the name) the version.  -->
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="40"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Symbol="Chat24" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="课堂同传助手" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        ToolTip="版本（点开看各版本的说明）">
                        <Hyperlink NavigateUri="https://github.com/YingQiu0871/LectureInterpreter/releases" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run x:Name="Version" Text="1.1.1.1" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <TextBlock
                    Margin="0,12,0,0"
                    LineHeight="22"
                    TextAlignment="Left"
                    TextWrapping="Wrap">
                    <Run Text="课堂同传助手由 @YingQiu0871 基于开源项目 LiveCaptions Translator 改造，增加了课堂分节总结、时间线、双语浮窗、笔记初稿和耳机播报。问题和建议欢迎在本项目的 GitHub Issue 反馈。" />
                    <Run Text="&#x0A;如果觉得好用，欢迎给本项目和原项目点个 Star！" />
                </TextBlock>

                <!--  A line with the same distance above and below (the separator of the theme brings 12 of its own on each side: the page would no longer fit the window).  -->
                <Border
                    Height="1"
                    Margin="0,16,0,16"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource Key}"
                        Text="本项目仓库" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource Value}">
                        <Hyperlink NavigateUri="https://github.com/YingQiu0871/LectureInterpreter" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="github.com/YingQiu0871/LectureInterpreter" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource Key}"
                        Text="作者" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource Value}">
                        <Hyperlink NavigateUri="https://github.com/YingQiu0871" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="@YingQiu0871" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource Key}"
                        Text="使用说明" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource Value}">
                        <Hyperlink NavigateUri="https://github.com/YingQiu0871/LectureInterpreter#readme" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="github.com/YingQiu0871/LectureInterpreter#readme" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock
                        Grid.Row="3"
                        Style="{StaticResource Key}"
                        Text="原项目仓库" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource Value}">
                        <Hyperlink NavigateUri="https://github.com/SakiRinn/LiveCaptions-Translator" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="github.com/SakiRinn/LiveCaptions-Translator" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock
                        Grid.Row="4"
                        Margin="0,0,16,0"
                        Style="{StaticResource Key}"
                        Text="原作者" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0"
                        Style="{StaticResource Value}">
                        <Hyperlink NavigateUri="https://github.com/SakiRinn" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="@SakiRinn" />
                        </Hyperlink>
                        <Run Text="（作者）和" />
                        <Hyperlink NavigateUri="https://github.com/A-nony-mous" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="@A-nony-mous" />
                        </Hyperlink>
                    </TextBlock>
                </Grid>

                <Border
                    Height="1"
                    Margin="0,16,0,16"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Key}"
                        Text="更新" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="UpdateLinkBlock"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <Hyperlink x:Name="UpdateLink" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run x:Name="UpdateLinkText" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <ui:Button
                        x:Name="CheckUpdateButton"
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        Click="CheckUpdateButton_Click"
                        Content="检查更新" />
                    <!--  Under what it belongs to. (Without the padding of the theme its box starts where the words above start.)  -->
                    <CheckBox
                        x:Name="AutoCheckBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        MinWidth="0"
                        Margin="0,4,0,0"
                        Padding="0,5,0,6"
                        Click="AutoCheckBox_Click"
                        Content="启动时自动检查更新" />
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
