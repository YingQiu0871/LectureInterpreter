<Page
    x:Class="LiveCaptionsTranslator.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="HistoryPage"
    FontSize="14"
    JournalEntry.KeepAlive="False"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  A course or a class: a card that opens on a click.  -->
        <Style
            x:Key="ItemCard"
            BasedOn="{StaticResource PageCard}"
            TargetType="Border">
            <Setter Property="Padding" Value="16,12,16,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="Crumb"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="6,4,6,4" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MouseOverBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <!--  The box that marks a card for "删除选中": only the box, at the right edge of its card. (Each box also says MinWidth="0" itself: the theme gives a box without words a width of 30, and only the box's own value outranks that.)  -->
        <Style
            x:Key="PickBox"
            BasedOn="{StaticResource {x:Type CheckBox}}"
            TargetType="CheckBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="选中后，用上面的“删除选中”一起删除" />
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Breadcrumb: 课程 › course › lecture  -->
            <!--  Moved left by the padding of its first button, so the icon stands where the cards begin. The name of the class takes the width that is left, and ends in "…" when that is not enough.  -->
            <Grid
                x:Name="Breadcrumb"
                MaxHeight="34.94"
                Margin="-7,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    x:Name="CrumbHome"
                    Click="CrumbHome_click"
                    Content="课程"
                    Icon="{ui:SymbolIcon Folder16,
                                         Filled=False}"
                    Style="{StaticResource Crumb}" />
                <TextBlock
                    x:Name="CrumbSep1"
                    Grid.Column="1"
                    Margin="2,0,2,0"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Text="›" />
                <ui:Button
                    x:Name="CrumbCourse"
                    Grid.Column="2"
                    MaxWidth="220"
                    Click="CrumbCourse_click"
                    Style="{StaticResource Crumb}" />
                <TextBlock
                    x:Name="CrumbSep2"
                    Grid.Column="3"
                    Margin="2,0,2,0"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Text="›" />
                <TextBlock
                    x:Name="CrumbLecture"
                    Grid.Column="4"
                    MaxWidth="280"
                    Margin="6,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
            <!--  Moved right by the padding and the outline of its last button, so the icon ends where the cards end.  -->
            <StackPanel
                Grid.Column="1"
                MaxHeight="34.94"
                Margin="8,0,-12,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    x:Name="NewCourse"
                    Appearance="Transparent"
                    Click="NewCourse_click"
                    Content="新建课程"
                    Icon="{ui:SymbolIcon FolderAdd16,
                                         Filled=False}"
                    MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <ui:Button
                    x:Name="AllSentences"
                    Margin="4,0,0,0"
                    Appearance="Transparent"
                    Click="AllSentences_click"
                    Content="全部句子"
                    Icon="{ui:SymbolIcon TextBulletListLtr16,
                                         Filled=False}"
                    MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                    ToolTip="不分课程，按时间列出所有句子" />
                <ui:Button
                    x:Name="RenameLecture"
                    Appearance="Transparent"
                    Click="RenameLecture_click"
                    Content="重命名"
                    Icon="{ui:SymbolIcon Rename16,
                                         Filled=False}"
                    MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <ui:Button
                    x:Name="NotesDraft"
                    Margin="4,0,0,0"
                    Appearance="Transparent"
                    Click="NotesDraft_click"
                    Content="生成笔记初稿"
                    Icon="{ui:SymbolIcon Notebook16,
                                         Filled=False}"
                    MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                    ToolTip="结合小节总结、转录和课件（若已上传）生成笔记初稿，保存在转录文件旁边" />
                <ui:Button
                    x:Name="OpenFile"
                    Margin="4,0,0,0"
                    Appearance="Transparent"
                    Click="OpenFile_click"
                    Content="打开文件位置"
                    Icon="{ui:SymbolIcon FolderOpen16,
                                         Filled=False}"
                    MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                    ToolTip="重新生成本节课的 Markdown 文件，并在资源管理器中显示" />
                <ui:Button
                    x:Name="Export"
                    Margin="4,0,0,0"
                    Appearance="Transparent"
                    Click="Export_click"
                    Icon="{ui:SymbolIcon ArrowDown12,
                                         Filled=False}"
                    MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                    ToolTip="导出全部句子 (CSV)" />
                <ui:Button
                    x:Name="Delete"
                    Margin="4,0,0,0"
                    Appearance="Transparent"
                    Click="Delete_click"
                    Icon="{ui:SymbolIcon Delete12,
                                         Filled=False}"
                    MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                    ToolTip="全部删除" />
                <ui:Button
                    x:Name="DeleteSelected"
                    Margin="4,0,0,0"
                    Appearance="Transparent"
                    Click="DeleteSelected_click"
                    Content="删除选中"
                    MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <ui:Button
                    x:Name="Refresh"
                    Margin="4,0,0,0"
                    Appearance="Transparent"
                    Click="Refresh_click"
                    Icon="{ui:SymbolIcon ArrowClockwise12,
                                         Filled=False}"
                    MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                    ToolTip="刷新" />
            </StackPanel>
        </Grid>

        <!--  What an empty level says, in the middle of the page.  -->
        <TextBlock
            x:Name="CourseEmptyHint"
            Grid.Row="1"
            Style="{StaticResource EmptyHint}"
            Text="还没有课程。上完一节课点“停止”后，会让你给这节课命名并选择课程，它就会出现在这里。"
            Visibility="Collapsed" />
        <TextBlock
            x:Name="LectureEmptyHint"
            Grid.Row="1"
            Style="{StaticResource EmptyHint}"
            Text="这个课程还没有录音。"
            Visibility="Collapsed" />
        <TextBlock
            x:Name="DetailEmptyHint"
            Grid.Row="1"
            Style="{StaticResource EmptyHint}"
            Text="这节课没有识别到内容。"
            Visibility="Collapsed" />

        <!--  Level 1: course folders. (The scroll bars of the lists stand in the margin of the page, next to the cards and not on them.)  -->
        <ScrollViewer
            x:Name="CourseScroll"
            Grid.Row="1"
            Margin="0,12,-14,0"
            VerticalScrollBarVisibility="Auto">
            <!--  As many columns as fit (the code counts them into Tag); the cards share the width evenly, and the last one of a row ends where the page ends.  -->
            <ItemsControl x:Name="CourseList" Margin="0,0,2,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid VerticalAlignment="Top" Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,12,12"
                            MouseLeftButtonUp="Course_click"
                            Style="{StaticResource ItemCard}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="RenameCourse_click" Header="重命名" />
                                    <MenuItem Click="DeleteCourse_click" Header="删除（仅空文件夹）" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Symbol="Folder24" />
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Name}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Info}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <CheckBox
                                    Grid.Column="2"
                                    MinWidth="0"
                                    Checked="CourseChecked"
                                    Style="{StaticResource PickBox}"
                                    Unchecked="CourseUnchecked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Level 2: the recordings of a course, each a row as wide as the page  -->
        <ScrollViewer
            x:Name="LectureScroll"
            Grid.Row="1"
            Margin="0,12,-14,0"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">
            <ItemsControl x:Name="LectureList" Margin="0,0,14,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,8"
                            MouseLeftButtonUp="Lecture_click"
                            Style="{StaticResource ItemCard}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="RenameLectureMenu_click" Header="重命名 / 移到其他课程" />
                                    <MenuItem Click="DeleteLecture_click" Header="删除这节课" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Symbol="DocumentText24" />
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Info}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <CheckBox
                                    Grid.Column="2"
                                    MinWidth="0"
                                    Checked="LectureChecked"
                                    Style="{StaticResource PickBox}"
                                    Unchecked="LectureUnchecked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Level 3: one recording: every section a card, with its summary and then its sentences  -->
        <ScrollViewer
            x:Name="DetailScroll"
            Grid.Row="1"
            Margin="0,12,-14,0"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">
            <StackPanel Margin="0,0,14,0">
                <TextBlock
                    x:Name="DetailInfo"
                    Margin="0,0,0,8"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <ItemsControl x:Name="DetailList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,12"
                                Padding="0"
                                Style="{StaticResource PageCard}">
                                <StackPanel>
                                    <StackPanel Margin="16,12,16,12">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <Ellipse
                                                Width="7"
                                                Height="7"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                Text="{Binding Header}" />
                                        </StackPanel>
                                        <!--  (The sentences before the first section have no title: no empty line then.)  -->
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Title}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!--  The summary, on a tint of the accent color.  -->
                                        <Grid Margin="0,8,0,0" Visibility="{Binding SummaryVisibility}">
                                            <Border
                                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                CornerRadius="8"
                                                Opacity="0.08" />
                                            <TextBlock
                                                Margin="12,8,12,10"
                                                LineHeight="22"
                                                Text="{Binding Summary}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!--  A sentence: when, then what was said and its translation.  -->
                                                <Border
                                                    Padding="16,10,16,12"
                                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="0,1,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Margin="0,1,0,0"
                                                            FontFamily="Consolas"
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Time, StringFormat=HH:mm:ss, Mode=OneWay}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding SourceText, Mode=OneWay}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Margin="0,3,0,0"
                                                                FontSize="15"
                                                                Text="{Binding TranslatedText}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!--  All sentences  -->
        <Grid
            x:Name="AllView"
            Grid.Row="1"
            Margin="0,12,0,0"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                MaxHeight="34.94"
                Margin="-12,0,0,0"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                    <ui:Button
                        x:Name="PageDown"
                        Appearance="Transparent"
                        Click="PageDown_click"
                        Icon="{ui:SymbolIcon chevronLeft12,
                                             Filled=False}"
                        MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                        ToolTip="上一页" />

                    <ui:TextBlock
                        x:Name="PageNumber"
                        MinWidth="40"
                        Margin="4,0,4,0"
                        VerticalAlignment="Center"
                        Text="1/1"
                        TextAlignment="Center" />

                    <ui:Button
                        x:Name="PageUp"
                        Appearance="Transparent"
                        Click="PageUp_click"
                        Icon="{ui:SymbolIcon chevronRight12,
                                             Filled=False}"
                        MouseOverBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                        ToolTip="下一页" />

                    <ComboBox
                        x:Name="HistoryMaxRow"
                        MinHeight="0"
                        Margin="8,0,0,0"
                        Padding="10,4,10,7"
                        VerticalAlignment="Stretch"
                        SelectedIndex="1">
                        <ComboBoxItem Content="20 条/页" Tag="20" />
                        <ComboBoxItem Content="30 条/页" Tag="30" />
                        <ComboBoxItem Content="50 条/页" Tag="50" />
                        <ComboBoxItem Content="100 条/页" Tag="100" />
                    </ComboBox>

                    <ui:AutoSuggestBox
                        x:Name="HistorySearchBox"
                        MinWidth="200"
                        MaxWidth="200"
                        Margin="8,0,0,0"
                        PlaceholderText="搜索"
                        QuerySubmitted="HistorySearchBox_QuerySubmitted"
                        TextChanged="HistorySearchBox_TextChanged" />

                </StackPanel>
        <DataGrid
            x:Name="HistoryDataGrid"
            SelectionMode="Extended"
            Grid.Row="1"
            Margin="0,8,0,0"
            VerticalAlignment="Stretch"
            AutoGenerateColumns="False"
            BorderThickness="0,0,0,0"
            EnableRowVirtualization="True"
            GridLinesVisibility="Horizontal"
            IsReadOnly="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.VerticalGridLinesBrush>
                <LinearGradientBrush MappingMode="Absolute" EndPoint="0,3">
                    <GradientStop Offset="0.33" Color="#18FFFFFF" />
                    <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </DataGrid.VerticalGridLinesBrush>
            <DataGrid.HorizontalGridLinesBrush>
                <LinearGradientBrush MappingMode="Absolute" EndPoint="0,3">
                    <GradientStop Offset="0.33" Color="#18FFFFFF" />
                    <GradientStop Offset="1" Color="#33000000" />
                </LinearGradientBrush>
            </DataGrid.HorizontalGridLinesBrush>
            <DataGrid.BorderBrush>
                <LinearGradientBrush MappingMode="Absolute" EndPoint="0,3">
                    <GradientStop Offset="0.33" Color="#18FFFFFF" />
                    <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </DataGrid.BorderBrush>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="0.4*" Header="时间">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding Timestamp}"
                                TextWrapping="Wrap"
                                ToolTip="{Binding TimestampFull}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" Header="原文">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" Header="译文">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TranslatedText}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="0.3*" Header="接口">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ApiUsed}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Grid>
    </Grid>
</Page>
