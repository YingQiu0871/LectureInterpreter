<Page
    x:Class="LiveCaptionsTranslator.CaptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CaptionPage"
    FontSize="14"
    JournalEntry.KeepAlive="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="SectionColumn" Width="320" MinWidth="180" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="LeftPane" Grid.Column="0" Grid.RowSpan="2" Margin="16,16,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style x:Key="CaptionBlockStyle" TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </Style>
            </Grid.Resources>

            <!--  Every finished sentence of this class, oldest first.  -->
            <Border
                Grid.Row="0"
                Padding="0"
                Style="{StaticResource PageCard}" />
            <TextBlock
                x:Name="TranscriptEmptyHint"
                Grid.Row="0"
                MaxWidth="300"
                Margin="24,16,24,16"
                FontSize="13"
                Style="{StaticResource EmptyHint}"
                Text="开始上课后，每句原文和译文会按顺序列在这里，最新的在最下面。" />
            <ScrollViewer
                x:Name="TranscriptScroll"
                Grid.Row="0"
                Margin="0,4,0,4"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TranscriptList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="12,0,12,0"
                                Padding="4,10,4,12"
                                Opacity="{Binding Opacity}"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock
                                        Cursor="Hand"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                                        Text="{Binding SourceText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding DataContext.OriginalVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        ToolTip="单击复制" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Cursor="Hand"
                                        FontSize="15"
                                        LineHeight="22"
                                        MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                                        Text="{Binding TranslatedText}"
                                        TextWrapping="Wrap"
                                        ToolTip="单击复制" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  E.g. LiveCaptions' own translation is on, so the "original" is already Chinese.  -->
            <Border
                Grid.Row="1"
                Margin="0,8,0,0"
                Padding="12,8"
                Background="#33FFB900"
                BorderBrush="#99FFB900"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding SourceWarningVisibility}">
                <TextBlock Text="{Binding SourceWarning}" TextWrapping="Wrap" />
            </Border>

            <!--  The sentence being spoken right now: a card of its own, with an accent bar on the left.  -->
            <Border
                Grid.Row="2"
                Margin="0,12,0,0"
                VerticalAlignment="Bottom"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Border
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="11"
                        Opacity="0.1" />
                    <Border
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="12" />
                    <Grid Margin="16,12,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <!--  Shown until LiveCaptions produces its first words, so an empty page doesn't look broken.  -->
                            <TextBlock
                                IsHitTestVisible="False"
                                Opacity="0.6"
                                Text="{Binding StatusHint}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DisplayOriginalCaption}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DisplayOriginalCaption}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock
                                x:Name="OriginalCaption"
                                Background="Transparent"
                                Cursor="Hand"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                                PreviewMouseWheel="OriginalCard_PreviewMouseWheel"
                                Style="{StaticResource CaptionBlockStyle}"
                                Text="{Binding DisplayOriginalCaption, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="单击复制，Ctrl+滚轮调整字号"
                                Visibility="{Binding OriginalVisibility}" />
                            <TextBlock
                                x:Name="TranslatedCaption"
                                Margin="0,6,0,0"
                                Background="Transparent"
                                Cursor="Hand"
                                FontSize="15"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                                PreviewMouseWheel="TranslatedCard_PreviewMouseWheel"
                                Style="{StaticResource CaptionBlockStyle}"
                                Text="{Binding DisplayTranslatedCaption, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="单击复制，Ctrl+滚轮调整字号" />
                        </StackPanel>
                        <!--  In the corner of the card it enlarges: both columns of the page start at the same height.  -->
                        <ToggleButton
                            x:Name="BigModeToggle"
                            Grid.Column="1"
                            MinHeight="0"
                            Margin="12,0,0,0"
                            Padding="12,3,12,3"
                            VerticalAlignment="Top"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Checked="BigModeToggle_Changed"
                            Content="大字"
                            FontSize="12"
                            ToolTip="大字模式：隐藏小节总结，放大正在识别的一句"
                            Unchecked="BigModeToggle_Changed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  Drag to change the width of the two columns.  -->
        <GridSplitter
            x:Name="SectionSplitter"
            Grid.Column="1"
            Width="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeWE"
            DragCompleted="SectionSplitter_DragCompleted"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            ToolTip="拖动调整宽度" />

        <!--  The sections of this class, in cards of their own; both columns start with a card at the same height.  -->
        <Grid x:Name="SectionPanel" Grid.Column="2" Margin="0,16,16,0">
            <Border
                x:Name="SectionEmptyHint"
                Margin="0,0,0,12"
                Padding="24,16,24,16"
                Style="{StaticResource PageCard}">
                <TextBlock
                    MaxWidth="300"
                    FontSize="13"
                    Style="{StaticResource EmptyHint}"
                    Text="这节课还没有小节。开始上课后会自动分节总结，也可以按 Ctrl+Alt+S 手动结束本节。" />
            </Border>
            <!--  The scroll bar stands in the margin of the page, next to the cards and not on them.  -->
            <ScrollViewer
                x:Name="SectionScroll"
                Margin="0,0,-14,0"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SectionList" Margin="0,0,14,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,12"
                                Padding="14,12,14,12"
                                Style="{StaticResource PageCard}">
                                <StackPanel>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            Text="{Binding TimeRange}" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="13"
                                        LineHeight="20"
                                        Text="{Binding Body}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!--  What the summaries are doing, next to the button that ends a section (the code keeps the button's width free on the right).  -->
        <Grid
            x:Name="StatusHost"
            Grid.Row="1"
            Grid.Column="2"
            Margin="2,0,128,16"
            VerticalAlignment="Center">
            <TextBlock
                x:Name="SummaryStatus"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>

        <!--  Stays visible in large-text mode too.  -->
        <ui:Button
            x:Name="EndSectionButton"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,0,16,16"
            Padding="14,5,14,5"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Appearance="Secondary"
            Click="EndSectionButton_Click"
            CornerRadius="8"
            Content="结束本节"
            FontSize="13"
            Icon="{ui:SymbolIcon Flag16,
                                 Filled=False}"
            SizeChanged="EndSectionButton_SizeChanged"
            ToolTip="结束本节并总结 (Ctrl+Alt+S)" />
    </Grid>
</Page>
