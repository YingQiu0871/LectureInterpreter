<Page
    x:Class="LiveCaptionsTranslator.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="TimelinePage"
    FontSize="14"
    JournalEntry.KeepAlive="False"
    mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  One row of controls of one height: which class, what to do with it, and (quiet, on the right) the rest. In a narrow window the box of the class gives way, so nothing runs into anything.  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition
                    Width="100*"
                    MinWidth="96"
                    MaxWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="CourseBox"
                Grid.Column="0"
                Width="140"
                VerticalAlignment="Center"
                DisplayMemberPath="Name"
                SelectionChanged="CourseBox_SelectionChanged"
                ToolTip="课程" />
            <TextBlock
                Grid.Column="1"
                Margin="8,0,8,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="›" />
            <ComboBox
                x:Name="LectureBox"
                Grid.Column="2"
                VerticalAlignment="Center"
                SelectionChanged="LectureBox_SelectionChanged"
                ToolTip="本节课">
                <ComboBox.ItemTemplate>
                    <!--  The list says when a class was and how long; the box itself only its name, in one line like the box next to it.  -->
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="InfoLine"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Info}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                <Setter TargetName="InfoLine" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <!--  The buttons are as tall as the boxes next to them.  -->
            <StackPanel
                Grid.Column="3"
                Margin="12,0,0,0"
                Orientation="Horizontal">
                <ui:Button
                    x:Name="EndSection"
                    VerticalAlignment="Stretch"
                    Appearance="Secondary"
                    Click="EndSection_click"
                    Content="结束本节并总结"
                    Icon="{ui:SymbolIcon Flag16,
                                         Filled=False}"
                    ToolTip="Ctrl+Alt+S" />
                <ui:Button
                    x:Name="LoadSlides"
                    Margin="8,0,0,0"
                    VerticalAlignment="Stretch"
                    Appearance="Secondary"
                    Click="LoadSlides_click"
                    Content="上传课件"
                    Icon="{ui:SymbolIcon DocumentPdf16,
                                         Filled=False}"
                    ToolTip="载入后按课件页码分节" />
                <ui:Button
                    x:Name="ClearSlides"
                    Margin="4,0,0,0"
                    Appearance="Transparent"
                    Click="ClearSlides_click"
                    Icon="{ui:SymbolIcon Dismiss12,
                                         Filled=False}"
                    ToolTip="移除课件"
                    Visibility="Collapsed" />
            </StackPanel>

            <!--  Moved right by the padding and the outline of its last button, so the icon ends where the cards end.  -->
            <StackPanel
                Grid.Column="5"
                Margin="8,0,-12,0"
                Orientation="Horizontal">
                <ui:Button
                    x:Name="Export"
                    Appearance="Transparent"
                    Click="Export_click"
                    Icon="{ui:SymbolIcon ArrowDown12,
                                         Filled=False}"
                    MouseOverBackground="#07000000"
                    ToolTip="导出这节课的转录 (Markdown)" />
                <ui:Button
                    x:Name="Refresh"
                    Margin="4,0,0,0"
                    Appearance="Transparent"
                    Click="Refresh_click"
                    Icon="{ui:SymbolIcon ArrowClockwise12,
                                         Filled=False}"
                    MouseOverBackground="#07000000"
                    ToolTip="刷新" />
            </StackPanel>
        </Grid>

        <!--  Which slides the sections follow: a line of its own under the controls, so a long file name has room.  -->
        <TextBlock
            x:Name="SlidesInfo"
            Grid.Row="1"
            Margin="0,8,0,0"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis" />

        <TextBlock
            x:Name="EmptyHint"
            Grid.Row="2"
            Style="{StaticResource EmptyHint}"
            Text="这节课还没有小节总结。上课时每隔几分钟会自动生成一节，也可以随时按 Ctrl+Alt+S 手动结束本节。"
            Visibility="Collapsed" />

        <!--  The scroll bar stands in the margin of the page, next to the cards and not on them.  -->
        <ScrollViewer
            x:Name="SectionScroll"
            Grid.Row="2"
            Margin="0,12,-14,0"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SectionList" Margin="0,0,14,0">
                <ItemsControl.ItemTemplate>
                    <!--  The same card as on the caption page: when, what about, what was said.  -->
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="16,12,16,12"
                            Style="{StaticResource PageCard}">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Text="{Binding TimeRange}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontWeight="SemiBold"
                                    Text="{Binding Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    LineHeight="22"
                                    Text="{Binding Body}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
