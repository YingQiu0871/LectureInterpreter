<ui:FluentWindow
    x:Class="LiveCaptionsTranslator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="课堂同传助手"
    Width="900"
    Height="560"
    MinWidth="750"
    MinHeight="420"
    Background="Transparent"
    ExtendsContentIntoTitleBar="True"
    LocationChanged="MainWindow_LocationChanged"
    PreviewMouseWheel="MainWindow_PreviewMouseWheel"
    ResizeMode="CanResize"
    SizeChanged="MainWindow_SizeChanged"
    Topmost="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <Grid x:Name="MainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TitleBar
                Grid.Row="0"
                Height="42"
                ShowMaximize="True">
                <ui:TitleBar.Header>
                    <StackPanel Margin="15,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Image
                            x:Name="LogoImage"
                            Width="20"
                            Height="20"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                        <ui:SymbolIcon
                            x:Name="LogoFallback"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Symbol="Chat24" />
                        <ui:TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold">课堂同传助手</ui:TextBlock>
                    </StackPanel>
                </ui:TitleBar.Header>
                <ui:TitleBar.TrailingContent>
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <!--  Class control  -->
                        <ui:Button
                            x:Name="StartButton"
                            Margin="0,0,8,0"
                            Padding="14,4,16,4"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Appearance="Primary"
                            Click="StartButton_Click"
                            CornerRadius="16"
                            Content="开始"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Icon="{ui:SymbolIcon Play16,
                                                 Filled=True}"
                            ToolTip="开始 / 停止上课" />
                        <ui:Button
                            x:Name="LogOnlyButton"
                            Padding="12,4,14,4"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Appearance="Secondary"
                            Click="LogOnlyButton_Click"
                            CornerRadius="16"
                            Content="暂停翻译"
                            FontSize="13"
                            Icon="{ui:SymbolIcon Pause16,
                                                 Filled=False}"
                            ToolTip="暂停翻译（只记录原文）" />

                        <Border
                            Width="1"
                            Height="20"
                            Margin="12,0,12,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!--  Output  -->
                        <ui:ToggleSwitch
                            x:Name="SpeechSwitch"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Click="SpeechSwitch_Click"
                            Content="耳机播报"
                            FontSize="13"
                            ToolTip="打开 / 关闭耳机播报 (Ctrl+Alt+M)" />
                        <ui:Button
                            x:Name="CaptionLogButton"
                            Margin="0,0,5,0"
                            Appearance="Transparent"
                            Click="CaptionLogButton_Click"
                            CornerRadius="8"
                            Icon="{ui:SymbolIcon History16,
                                                 Filled=False}"
                            ToolTip="历史卡片"
                            Visibility="Collapsed" />
                        <ui:Button
                            x:Name="FloatMenuButton"
                            Padding="12,4,12,4"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Appearance="Secondary"
                            Click="FloatMenuButton_Click"
                            CornerRadius="8"
                            Content="浮窗"
                            FontSize="13"
                            Icon="{ui:SymbolIcon ChevronDown12,
                                                 Filled=False}"
                            ToolTip="悬浮字幕 / 双语浮窗">
                            <ui:Button.ContextMenu>
                                <ContextMenu x:Name="FloatMenu" Opened="FloatMenu_Opened">
                                    <MenuItem
                                        x:Name="OverlayMenuItem"
                                        Click="OverlayMenuItem_Click"
                                        Header="悬浮字幕" />
                                    <MenuItem
                                        x:Name="BilingualMenuItem"
                                        Click="BilingualMenuItem_Click"
                                        Header="双语浮窗" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                        <!--  The original buttons keep the window logic and their icons; the menu above drives them.  -->
                        <ui:Button
                            x:Name="OverlayModeButton"
                            Appearance="Transparent"
                            Click="OverlayModeButton_Click"
                            Icon="{ui:SymbolIcon ClosedCaptionOff24,
                                                 Filled=False}"
                            ToolTip="悬浮字幕窗"
                            Visibility="Collapsed" />
                        <ui:Button
                            x:Name="BilingualModeButton"
                            Appearance="Transparent"
                            Click="BilingualModeButton_Click"
                            Icon="{ui:SymbolIcon Translate24,
                                                 Filled=False}"
                            ToolTip="双语浮窗（原文 + 译文，半透明置顶）"
                            Visibility="Collapsed" />

                        <Border
                            Width="1"
                            Height="20"
                            Margin="12,0,12,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!--  Window  -->
                        <ui:Button
                            x:Name="TopmostButton"
                            Margin="0,0,5,0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Appearance="Transparent"
                            Click="TopmostButton_Click"
                            CornerRadius="8"
                            Icon="{ui:SymbolIcon Pin16,
                                                 Filled=True}"
                            ToolTip="窗口置顶" />
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>

            <ui:NavigationView
                x:Name="RootNavigation"
                Grid.Row="1"
                Height="Auto"
                HeaderVisibility="Collapsed"
                IsBackButtonVisible="Collapsed"
                IsPaneOpen="False"
                IsPaneToggleVisible="False"
                PaneDisplayMode="LeftMinimal">
                <ui:NavigationView.LayoutTransform>
                    <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
                </ui:NavigationView.LayoutTransform>
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem
                        Margin="0,6,0,3"
                        Content="字幕"
                        ToolTip="字幕"
                        ToolTipService.InitialShowDelay="300"
                        ToolTipService.Placement="Right"
                        FontFamily="Bahnschrift"
                        Icon="{ui:SymbolIcon Home24}"
                        NavigationCacheMode="Enabled"
                        TargetPageType="{x:Type local:CaptionPage}" />
                    <ui:NavigationViewItem
                        Margin="0,3,0,0"
                        Content="设置"
                        ToolTip="设置"
                        ToolTipService.InitialShowDelay="300"
                        ToolTipService.Placement="Right"
                        FontFamily="Bahnschrift"
                        Icon="{ui:SymbolIcon Settings24}"
                        NavigationCacheMode="Disabled"
                        TargetPageType="{x:Type local:LecturePage}" />
                    <ui:NavigationViewItem
                        Margin="0,3,0,0"
                        Content="时间线"
                        ToolTip="时间线"
                        ToolTipService.InitialShowDelay="300"
                        ToolTipService.Placement="Right"
                        FontFamily="Bahnschrift"
                        Icon="{ui:SymbolIcon Timeline24}"
                        NavigationCacheMode="Disabled"
                        TargetPageType="{x:Type local:TimelinePage}" />
                    <ui:NavigationViewItem
                        Margin="0,3,0,0"
                        Content="历史"
                        ToolTip="历史"
                        ToolTipService.InitialShowDelay="300"
                        ToolTipService.Placement="Right"
                        FontFamily="Bahnschrift"
                        Icon="{ui:SymbolIcon History24}"
                        NavigationCacheMode="Disabled"
                        TargetPageType="{x:Type local:HistoryPage}" />
                    <ui:NavigationViewItem
                        Margin="0,3,0,0"
                        Content="关于"
                        ToolTip="关于"
                        ToolTipService.InitialShowDelay="300"
                        ToolTipService.Placement="Right"
                        FontFamily="Bahnschrift"
                        Icon="{ui:SymbolIcon Info24}"
                        NavigationCacheMode="Required"
                        TargetPageType="{x:Type local:InfoPage}" />
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.ContentOverlay>
                    <Grid>
                        <ui:SnackbarPresenter
                            x:Name="snackbarHost"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" />
                    </Grid>
                </ui:NavigationView.ContentOverlay>
            </ui:NavigationView>
        </Grid>
        <ContentPresenter
            x:Name="DialogHostContainer"
            MinHeight="167"
            Visibility="Collapsed" />
    </Grid>
</ui:FluentWindow>
