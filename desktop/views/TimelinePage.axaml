<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:LiveCaptionsTranslator.models"
             x:Class="LiveCaptionsTranslator.TimelinePage">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ComboBox x:Name="CourseBox" MinWidth="140" MaxWidth="220" VerticalAlignment="Center"
                          ToolTip.Tip="课程" SelectionChanged="CourseBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="m:CourseEntry">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock VerticalAlignment="Center" Classes="secondary" Text="›" />
                <ComboBox x:Name="LectureBox" MinWidth="180" MaxWidth="280" VerticalAlignment="Center"
                          ToolTip.Tip="本节课" SelectionChanged="LectureBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="m:LectureRecord">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Classes="secondary" Text="{Binding Info}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="EndSection" Margin="2,0,0,0" Content="结束本节并总结" ToolTip.Tip="Ctrl+Alt+S"
                        Click="EndSection_Click" />
                <Button Content="上传课件" ToolTip.Tip="载入后按课件页码分节" Click="LoadSlides_Click" />
                <Button x:Name="ClearSlides" Classes="ghost" ToolTip.Tip="移除课件" IsVisible="False"
                        Click="ClearSlides_Click">
                    <!-- Drawn, not a "✕" character: not every Linux font has that glyph. -->
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter}}" StrokeThickness="1.5"
                          StrokeLineCap="Round" Margin="2" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="3,0">
                <Button x:Name="Export" Content="导出" Classes="ghost"
                        ToolTip.Tip="导出这节课的转录（Markdown）" Click="Export_Click" />
                <Button x:Name="Refresh" Content="刷新" Classes="ghost" ToolTip.Tip="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="SlidesInfo" Grid.Row="1" Margin="4,8,0,0" Classes="secondary" TextWrapping="Wrap" />

        <TextBlock x:Name="EmptyHint" Grid.Row="2" Margin="5,15,5,0" Classes="secondary" IsVisible="False"
                   Text="这节课还没有小节总结。上课时每隔几分钟会自动生成一节，也可以随时按 Ctrl+Alt+S 手动结束本节。"
                   TextWrapping="Wrap" />

        <ScrollViewer x:Name="SectionScroll" Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SectionList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:SectionEntry">
                        <Border Classes="card" Margin="0,0,12,12" Padding="14,10,14,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{DynamicResource BrandBrush}" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Classes="accent"
                                               VerticalAlignment="Center" Text="{Binding TimeRange}" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,3,0,0" FontSize="13" LineHeight="20" Text="{Binding Body}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
