<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:LiveCaptionsTranslator.models"
             x:Class="LiveCaptionsTranslator.TimelinePage">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*">
        <!-- One row of controls of one height: which class, what to do with it, and (quiet, on the right) the rest.
             In a narrow window the box of the class gives way, so nothing runs into anything. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100*" MinWidth="96" MaxWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CourseBox" Grid.Column="0" Width="140" VerticalAlignment="Center"
                      ToolTip.Tip="课程" SelectionChanged="CourseBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="m:CourseEntry">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Classes="secondary" Text="›" />
            <ComboBox x:Name="LectureBox" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ToolTip.Tip="本节课" SelectionChanged="LectureBox_SelectionChanged">
                <!-- The list says when a class was and how long; the box itself only its name, in one line
                     like the box next to it. -->
                <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate x:DataType="m:LectureRecord">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="m:LectureRecord">
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,1,0,0" FontSize="12" Classes="secondary" Text="{Binding Info}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                <Button x:Name="EndSection" Content="结束本节并总结" ToolTip.Tip="Ctrl+Alt+S"
                        Click="EndSection_Click" />
                <Button x:Name="LoadSlides" Content="上传课件" ToolTip.Tip="载入后按课件页码分节"
                        Click="LoadSlides_Click" />
                <Button x:Name="ClearSlides" Classes="ghost" Margin="-4,0,0,0" ToolTip.Tip="移除课件" IsVisible="False"
                        Click="ClearSlides_Click">
                    <!-- Drawn, not a "✕" character: not every Linux font has that glyph. -->
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter}}" StrokeThickness="1.5"
                          StrokeLineCap="Round" Margin="2" />
                </Button>
            </StackPanel>

            <!-- The words of the quiet buttons end where the cards end -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" Margin="8,0,-10,0">
                <Button x:Name="Export" Content="导出" Classes="ghost"
                        ToolTip.Tip="导出这节课的转录（Markdown）" Click="Export_Click" />
                <Button x:Name="Refresh" Content="刷新" Classes="ghost" ToolTip.Tip="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="SlidesInfo" Grid.Row="1" Margin="2,8,0,0" FontSize="12" Classes="secondary"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="EmptyHint" Grid.Row="2" Classes="empty" IsVisible="False"
                   Text="这节课还没有小节总结。上课时每隔几分钟会自动生成一节，也可以随时按 Ctrl+Alt+S 手动结束本节。" />

        <!-- The scroll bar stands in the margin of the page, next to the cards and not on them -->
        <ScrollViewer x:Name="SectionScroll" Grid.Row="2" Margin="0,12,-12,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SectionList" Margin="0,0,12,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:SectionEntry">
                        <Border Classes="card" Margin="0,0,0,12" Padding="16,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{DynamicResource BrandBrush}" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Classes="accent"
                                               VerticalAlignment="Center" Text="{Binding TimeRange}" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" LineHeight="20"
                                           Text="{Binding Title}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,3,0,0" FontSize="13" LineHeight="20" Text="{Binding Body}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
