<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:LiveCaptionsTranslator.models"
             x:Class="LiveCaptionsTranslator.HistoryPage">
    <UserControl.Styles>
        <!-- Where the reader is: the last name of the path, in the full text color -->
        <Style Selector="Button.crumb">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.crumb.current">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
    </UserControl.Styles>
    <Grid Margin="16" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <!-- Breadcrumb: 课程 › course › lecture. Its first word starts where the cards start; the name of the
                 class takes the room that is left. -->
            <Grid Margin="-10,0,0,0" ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                <Button x:Name="CrumbHome" Grid.Column="0" Content="课程" Classes="ghost crumb"
                        Click="CrumbHome_Click" />
                <TextBlock x:Name="CrumbSep1" Grid.Column="1" VerticalAlignment="Center" Classes="secondary" Text="›" />
                <Button x:Name="CrumbCourse" Grid.Column="2" MaxWidth="220" Classes="ghost crumb"
                        Click="CrumbCourse_Click" />
                <TextBlock x:Name="CrumbSep2" Grid.Column="3" VerticalAlignment="Center" Classes="secondary" Text="›" />
                <TextBlock x:Name="CrumbLecture" Grid.Column="4" MaxWidth="280" Margin="10,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </Grid>
            <!-- The words of the quiet buttons end where the cards end -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="8,0,-10,0">
                <Button x:Name="NewCourse" Content="新建课程" Classes="ghost" Click="NewCourse_Click" />
                <Button x:Name="AllSentences" Content="全部句子" Classes="ghost"
                        ToolTip.Tip="不分课程，按时间列出所有句子" Click="AllSentences_Click" />
                <Button x:Name="RenameLecture" Content="重命名" Classes="ghost" Click="RenameLecture_Click" />
                <Button x:Name="NotesDraft" Content="生成笔记初稿" Classes="ghost"
                        ToolTip.Tip="结合小节总结、转录和课件（若已上传）生成笔记初稿，保存在转录文件旁边"
                        Click="NotesDraft_Click" />
                <Button x:Name="OpenFile" Content="打开文件位置" Classes="ghost"
                        ToolTip.Tip="重新生成本节课的 Markdown 文件，并在文件管理器中显示" Click="OpenFile_Click" />
                <Button x:Name="Export" Content="导出" Classes="ghost" ToolTip.Tip="导出全部句子（CSV）"
                        Click="Export_Click" />
                <Button x:Name="Delete" Content="全部删除" Classes="ghost" ToolTip.Tip="全部删除"
                        Click="Delete_Click" />
                <Button x:Name="Refresh" Content="刷新" Classes="ghost" ToolTip.Tip="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <!-- Level 1: course folders, in columns of one width that fill the page -->
        <TextBlock x:Name="CourseEmptyHint" Grid.Row="1" Classes="empty" IsVisible="False"
                   Text="还没有课程。上完一节课点“停止”后，会让你给这节课命名并选择课程，它就会出现在这里。" />
        <!-- (The scroll bars of the three levels stand in the margin of the page, next to the cards.) -->
        <ScrollViewer x:Name="CourseScroll" Grid.Row="1" Margin="0,12,-12,0" VerticalScrollBarVisibility="Auto">
            <UniformGrid x:Name="CourseList" Columns="3" VerticalAlignment="Top" />
        </ScrollViewer>

        <!-- Level 2: the recordings of a course -->
        <TextBlock x:Name="LectureEmptyHint" Grid.Row="1" Classes="empty" IsVisible="False"
                   Text="这个课程还没有录音。" />
        <ScrollViewer x:Name="LectureScroll" Grid.Row="1" Margin="0,12,-12,0" VerticalScrollBarVisibility="Auto"
                      IsVisible="False">
            <StackPanel x:Name="LectureList" Margin="0,0,12,0" />
        </ScrollViewer>

        <!-- Level 3: one recording: per section a card with its summary and its sentences, laid out like the
             sentences of the caption page -->
        <TextBlock x:Name="DetailEmptyHint" Grid.Row="1" Classes="empty" IsVisible="False"
                   Text="这节课没有识别到内容。" />
        <ScrollViewer x:Name="DetailScroll" Grid.Row="1" Margin="0,12,-12,0" VerticalScrollBarVisibility="Auto"
                      IsVisible="False">
            <StackPanel Margin="0,0,12,0">
                <TextBlock x:Name="DetailInfo" Margin="2,0,0,10" FontSize="12" Classes="secondary" TextWrapping="Wrap" />
                <ItemsControl x:Name="DetailList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:LectureSectionView">
                            <Border Classes="card" Margin="0,0,0,12" Padding="0" ClipToBounds="True">
                                <StackPanel>
                                    <StackPanel Margin="16,12,16,12">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{DynamicResource BrandBrush}" />
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Classes="accent"
                                                       VerticalAlignment="Center" Text="{Binding Header}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" LineHeight="20"
                                                   Text="{Binding Title}" TextWrapping="Wrap"
                                                   IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="8"
                                                Background="{DynamicResource BrandSoftBrush}"
                                                IsVisible="{Binding IsSummaryVisible}">
                                            <TextBlock FontSize="13" LineHeight="20" Text="{Binding Summary}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:HistoryLine">
                                                <Border Padding="16,10,16,12" BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource DividerBrush}">
                                                    <Grid ColumnDefinitions="64,*">
                                                        <TextBlock Grid.Column="0" Margin="0,1,0,0" FontSize="12"
                                                                   Classes="secondary" Opacity="0.8"
                                                                   Text="{Binding Time, StringFormat=HH:mm:ss}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock FontSize="12" LineHeight="18" Classes="secondary"
                                                                       Text="{Binding SourceText}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,2,0,0" FontSize="15" LineHeight="22"
                                                                       Text="{Binding TranslatedText}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- All sentences: a row to page and search, then the table in a card -->
        <Grid x:Name="AllView" Grid.Row="1" Margin="0,12,0,0" IsVisible="False" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                <Button Content="‹" Classes="ghost" Width="32" Padding="0" ToolTip.Tip="上一页" Click="PageDown_Click" />
                <TextBlock x:Name="PageNumber" MinWidth="36" VerticalAlignment="Center" TextAlignment="Center"
                           Text="1/1" />
                <Button Content="›" Classes="ghost" Width="32" Padding="0" ToolTip.Tip="下一页" Click="PageUp_Click" />
                <ComboBox x:Name="HistoryMaxRow" Width="112" SelectedIndex="1" VerticalAlignment="Center">
                    <ComboBoxItem Content="20 条/页" Tag="20" />
                    <ComboBoxItem Content="30 条/页" Tag="30" />
                    <ComboBoxItem Content="50 条/页" Tag="50" />
                    <ComboBoxItem Content="100 条/页" Tag="100" />
                </ComboBox>
                <TextBox x:Name="HistorySearchBox" Width="200" Watermark="搜索" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Row="1" Classes="card" Margin="0,12,0,0" Padding="0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="16,10" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource CardBorderBrush}">
                        <Grid ColumnDefinitions="0.4*,*,*,0.3*">
                            <TextBlock Grid.Column="0" FontSize="12" Classes="secondary" FontWeight="SemiBold" Text="时间" />
                            <TextBlock Grid.Column="1" FontSize="12" Classes="secondary" FontWeight="SemiBold" Text="原文" />
                            <TextBlock Grid.Column="2" FontSize="12" Classes="secondary" FontWeight="SemiBold" Text="译文" />
                            <TextBlock Grid.Column="3" FontSize="12" Classes="secondary" FontWeight="SemiBold" Text="接口" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:TranslationHistoryEntry">
                                    <Border Padding="16,8" BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource DividerBrush}">
                                        <Grid ColumnDefinitions="0.4*,*,*,0.3*">
                                            <TextBlock Grid.Column="0" Margin="0,0,8,0" Classes="secondary"
                                                       Text="{Binding Timestamp}" TextWrapping="Wrap"
                                                       ToolTip.Tip="{Binding TimestampFull}" />
                                            <TextBlock Grid.Column="1" Margin="0,0,12,0" LineHeight="19"
                                                       Text="{Binding SourceText}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Margin="0,0,12,0" LineHeight="19"
                                                       Text="{Binding TranslatedText}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" Classes="secondary" Text="{Binding ApiUsed}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
