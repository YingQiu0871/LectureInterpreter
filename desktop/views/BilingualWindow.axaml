<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveCaptionsTranslator.BilingualWindow"
        Title="双语浮窗"
        Icon="/assets/icon.png"
        Width="720"
        MinWidth="360" MinHeight="80"
        SizeToContent="Height"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        CanResize="True"
        ShowInTaskbar="False"
        Topmost="True">
    <Window.Styles>
        <!-- Small round-cornered, translucent white buttons -->
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tool /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#40FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#55FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.edge">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid>
        <Border x:Name="PanelBorder" Margin="5" CornerRadius="12" Background="#CC111827">
            <Grid>
                <ScrollViewer x:Name="PairScroll" Margin="16,12" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="HintText" Foreground="#FFC8C8C8" TextWrapping="Wrap" />
                        <StackPanel x:Name="PairPanel" />
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="ControlPanel" Margin="0,6,10,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        CornerRadius="8" Background="#E6111827" IsVisible="False">
                    <StackPanel Margin="3" Orientation="Horizontal">
                        <Button x:Name="PinButton" Classes="tool" Content="置顶" ToolTip.Tip="置顶（点击切换）"
                                Click="PinButton_Click" />
                        <Button Classes="tool" Margin="6,1,1,1" Content="锁定"
                                ToolTip.Tip="锁定（鼠标穿透，在主窗口「浮窗」菜单里解锁）" Click="LockButton_Click" />
                        <Button Classes="tool" Margin="6,1,1,1" Content="A+" ToolTip.Tip="字号加大"
                                Click="FontIncrease_Click" />
                        <Button Classes="tool" Content="A−" ToolTip.Tip="字号减小" Click="FontDecrease_Click" />
                        <Button Classes="tool" Margin="6,1,1,1" Content="深" ToolTip.Tip="背景加深"
                                Click="OpacityIncrease_Click" />
                        <Button Classes="tool" Content="浅" ToolTip.Tip="背景变浅" Click="OpacityDecrease_Click" />
                        <Button x:Name="SentencesButton" Classes="tool" Margin="6,1,1,1"
                                ToolTip.Tip="显示的句数（点击在 1–5 句之间切换）" Click="SentencesButton_Click" />
                        <Button Classes="tool" Margin="6,1,1,1" ToolTip.Tip="关闭双语浮窗" Click="CloseButton_Click">
                            <Path Data="M0,0 L8,8 M8,0 L0,8" StrokeThickness="1.5" StrokeLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter}}" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Resize handles on the edges and corners; until the height is dragged it follows the text -->
        <Border x:Name="TopEdge" Classes="edge" Height="6" VerticalAlignment="Top" Margin="10,0" Cursor="SizeNorthSouth" />
        <Border x:Name="BottomEdge" Classes="edge" Height="6" VerticalAlignment="Bottom" Margin="10,0" Cursor="SizeNorthSouth" />
        <Border x:Name="LeftEdge" Classes="edge" Width="6" HorizontalAlignment="Left" Margin="0,10" Cursor="SizeWestEast" />
        <Border x:Name="RightEdge" Classes="edge" Width="6" HorizontalAlignment="Right" Margin="0,10" Cursor="SizeWestEast" />
        <Border x:Name="TopLeftEdge" Classes="edge" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="TopLeftCorner" />
        <Border x:Name="TopRightEdge" Classes="edge" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                Cursor="TopRightCorner" />
        <Border x:Name="BottomLeftEdge" Classes="edge" Width="10" Height="10" HorizontalAlignment="Left"
                VerticalAlignment="Bottom" Cursor="BottomLeftCorner" />
        <Border x:Name="BottomRightEdge" Classes="edge" Width="10" Height="10" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Cursor="BottomRightCorner" />
    </Grid>
</Window>
